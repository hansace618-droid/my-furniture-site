---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({
    params: { slug: p.id },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);

const phone = '8617336031842';
const waMsg = `I want to inquire about ${product.data.title} (SKU: ${product.id})`;
const waLink = `https://api.whatsapp.com/send/?phone=${phone}&text=${encodeURIComponent(waMsg)}`;

// 主图 + gallery 去重合并
const galleryImgs = [product.data.image, ...(product.data.gallery || [])].filter(
  (v, i, a) => a.indexOf(v) === i
);
---
<Layout title={product.data.title}>
  <p><a href="/products/" target="_blank" rel="noopener">&#8592; Back to all products</a></p>

  <div class="gallery-wrap">
    <img id="galleryMain" class="gallery-main" src={galleryImgs[0]} alt={product.data.title} />
    {galleryImgs.length > 1 && (
      <div class="gallery-thumbs">
        {galleryImgs.map((g, i) => (
          <button
            class={`thumb${i === 0 ? ' active' : ''}`}
            type="button"
            aria-label={`Image ${i + 1}`}
            data-idx={i}
            data-src={g}
          >
            <img src={g} alt="" loading="lazy" />
          </button>
        ))}
      </div>
    )}
  </div>

  <h1>{product.data.title}</h1>
  <p>Category: <a href={`/category/${product.data.categorySlug}/`} target="_blank" rel="noopener">{product.data.category}</a></p>
  <p class="sku">SKU: {product.id}</p>
  <Content />
  <div style="margin-top:2rem;">
    <a href={waLink} target="_blank" class="btn btn-wa">&#128172; CHAT ON WHATSAPP</a>
  </div>
</Layout>

<script is:inline>
  const main = document.getElementById('galleryMain');
  const thumbs = document.querySelectorAll('.gallery-thumbs .thumb');
  const setImg = (t) => {
    if (!main || !t) return;
    main.src = t.dataset.src;
    thumbs.forEach((x) => x.classList.toggle('active', x === t));
  };
  thumbs.forEach((t) => t.addEventListener('click', () => setImg(t)));
</script>