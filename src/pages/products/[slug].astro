---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({
    params: { slug: p.id },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);

const phone = '8617336031842';
const waMsg = `I want to inquire about ${product.data.title} (SKU: ${product.id})`;
const waLink = `https://api.whatsapp.com/send/?phone=${phone}&text=${encodeURIComponent(waMsg)}`;
---
<Layout title={product.data.title}>
  <p><a href="/products/">&#8592; Back to all products</a></p>
  <img src={product.data.image} alt={product.data.title} />
  <h1>{product.data.title}</h1>
  <p>Category: <a href={`/category/${product.data.categorySlug}/`}>{product.data.category}</a></p>
  <p class="sku">SKU: {product.id}</p>
  <Content />
  {product.data.gallery && product.data.gallery.length > 0 && (
    <div>
      <h2>More Images</h2>
      {product.data.gallery.map((g) => <img src={g} alt={product.data.title} loading="lazy" />)}
    </div>
  )}
  <div style="margin-top:2rem;">
    <a href={waLink} target="_blank" class="btn btn-wa">&#128172; CHAT ON WHATSAPP</a>
  </div>
</Layout>
