---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
---
<Layout title="All Products | Tars Home">
  <h1>All Products</h1>
  <p>{allProducts.length} pieces &mdash; luxury French-Chinese style furniture &amp; home decor</p>
  {allProducts.length > 0 ? (
    <div class="product-grid">
      {allProducts.map((p) => (
        <a class="product-card" href={`/products/${p.id}/`}>
          <img src={p.data.image} alt={p.data.title} loading="lazy" />
          <h3>{p.data.title}</h3>
          <p>{p.data.category}</p>
        </a>
      ))}
    </div>
  ) : (
    <p>Products coming soon.</p>
  )}
</Layout>
