---
interface Props {
  title: string;
}
const { title } = Astro.props;
const phone = '8617336031842';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tars Home — luxury French-Chinese style furniture, handcrafted with refined details. Sofas, cabinets, tables, screens and home decor, made to order." />
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <header class="site-header">
      <!-- Desktop nav -->
      <nav class="nav">
        <a class="logo" href="/" target="_blank" rel="noopener"><img class="logo-img" src="/images/logo-header.png" alt="Tars Home" /></a>
        <div class="nav-links">
          <a href="/" target="_blank" rel="noopener">Home</a>
          <a href="/products/" target="_blank" rel="noopener">Products</a>
          <a href="/category/living-room/" target="_blank" rel="noopener">Living Room</a>
          <a href="/category/dining-room/" target="_blank" rel="noopener">Dining</a>
          <a href="/category/bedroom/" target="_blank" rel="noopener">Bedroom</a>
          <a href="/search/" target="_blank" rel="noopener">&#128269; Search</a>
        </div>
      </nav>
      <!-- Mobile nav: hamburger | logo | WhatsApp -->
      <div class="mobile-nav">
        <button class="hamburger" id="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
          <span></span><span></span><span></span>
        </button>
        <a class="logo mobile-logo" href="/" target="_blank" rel="noopener"><img class="logo-img" src="/images/logo-header.png" alt="Tars Home" /></a>
        <a class="wa-icon" href={`https://api.whatsapp.com/send/?phone=${phone}`} target="_blank" rel="noopener" aria-label="WhatsApp">
          <svg viewBox="0 0 448 512" aria-hidden="true" focusable="false"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
        </a>
      </div>
      <!-- Mobile dropdown menu -->
      <div class="mobile-menu" id="mobile-menu">
        <a href="/" target="_blank" rel="noopener">Home</a>
        <a href="/products/" target="_blank" rel="noopener">Products</a>
        <a href="/category/living-room/" target="_blank" rel="noopener">Living Room</a>
        <a href="/category/dining-room/" target="_blank" rel="noopener">Dining Room</a>
        <a href="/category/bedroom/" target="_blank" rel="noopener">Bedroom</a>
        <a href="/category/study/" target="_blank" rel="noopener">Study</a>
        <a href="/category/console-hall/" target="_blank" rel="noopener">Console &amp; Hall</a>
        <a href="/category/home-decoration/" target="_blank" rel="noopener">Home Decoration</a>
        <a href="/search/" target="_blank" rel="noopener">&#128269; Search</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-grid">
        <div>
          <h4>TARS HOME</h4>
          <p>Luxury French-Chinese style furniture, handcrafted with heritage craftsmanship. Custom orders welcome.</p>
        </div>
        <div>
          <h4>Shop</h4>
          <a href="/category/living-room/" target="_blank" rel="noopener">Living Room</a>
          <a href="/category/dining-room/" target="_blank" rel="noopener">Dining Room</a>
          <a href="/category/bedroom/" target="_blank" rel="noopener">Bedroom</a>
          <a href="/category/study/" target="_blank" rel="noopener">Study</a>
          <a href="/category/console-hall/" target="_blank" rel="noopener">Console &amp; Hall</a>
          <a href="/category/home-decoration/" target="_blank" rel="noopener">Home Decoration</a>
        </div>
        <div>
          <h4>Contact</h4>
          <a href={`https://api.whatsapp.com/send/?phone=${phone}`} target="_blank">WhatsApp Us</a>
          <p>Worldwide shipping available</p>
        </div>
      </div>
      <p class="copyright">&copy; {new Date().getFullYear()} Tars Home. All rights reserved.</p>
    </footer>
    <script is:inline>
      (function () {
        var toggle = document.getElementById('menu-toggle');
        var menu = document.getElementById('mobile-menu');
        if (!toggle || !menu) return;
        toggle.addEventListener('click', function () {
          var open = menu.classList.toggle('open');
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        menu.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', function () {
            menu.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
          });
        });
      })();
    </script>
  </body>
</html>
