---
interface Props {
  title: string;
}
const { title } = Astro.props;
const phone = '8617336031842';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tars Home — luxury French-Chinese style furniture, handcrafted with refined details. Sofas, cabinets, tables, screens and home decor, made to order." />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="logo" href="/">TARS HOME</a>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/products/">Products</a>
          <a href="/category/living-room/">Living Room</a>
          <a href="/category/dining-room/">Dining</a>
          <a href="/category/bedroom/">Bedroom</a>
          <a href="/search/">&#128269; Search</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-grid">
        <div>
          <h4>TARS HOME</h4>
          <p>Luxury French-Chinese style furniture, handcrafted with heritage craftsmanship. Custom orders welcome.</p>
        </div>
        <div>
          <h4>Shop</h4>
          <a href="/category/living-room/">Living Room</a>
          <a href="/category/dining-room/">Dining Room</a>
          <a href="/category/bedroom/">Bedroom</a>
          <a href="/category/study/">Study</a>
          <a href="/category/console-hall/">Console &amp; Hall</a>
          <a href="/category/home-decoration/">Home Decoration</a>
        </div>
        <div>
          <h4>Contact</h4>
          <a href={`https://api.whatsapp.com/send/?phone=${phone}`} target="_blank">WhatsApp Us</a>
          <p>Worldwide shipping available</p>
        </div>
      </div>
      <p class="copyright">&copy; {new Date().getFullYear()} Tars Home. All rights reserved.</p>
    </footer>
  </body>
</html>
